# Deepa Handmade API - environment variables
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# Comma-separated list of allowed browser origins (CORS). Required in production.
CORS_ORIGINS=http://localhost:3000

# MongoDB connection string (leave empty to run without a database)
# Local Docker (run: npm run infra:up) - credentials from infra/docker/.env:
# mongodb://deepa:deepa_pass@localhost:27017/deepa?authSource=admin
# Production (Atlas), e.g.:
# mongodb+srv://user:password@cluster0.mongodb.net/deepa
# Required in production.
MONGODB_URI=

# API rate limiting (in-memory sliding window, app-level)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# JWT secrets (required before auth module is enabled; required in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Health checks
HEALTH_MEMORY_HEAP_MB=512
HEALTH_DISK_PATH=.

# Swagger UI path (served by the API itself)
SWAGGER_PATH=api/docs
SWAGGER_ENABLED=true

# Logging: "pretty" (human readable) or "json" (structured, default in production)
LOG_FORMAT=

# Trust X-Forwarded-* headers when behind a reverse proxy (enabled in production)
TRUST_PROXY=false

# Request body size limit (express.json / urlencoded)
REQUEST_BODY_LIMIT=1mb

# Header used to carry/emit the request correlation id
REQUEST_ID_HEADER=x-request-id

# Graceful shutdown drain timeout in ms
SHUTDOWN_TIMEOUT_MS=10000

# Enable verbose Mongoose query logging (development only)
MONGOOSE_DEBUG=false