# Deepa Handmade API - environment variables
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3000

# MongoDB connection string (leave empty to run without a database)
# Local Docker (run: npm run infra:up) - credentials from infra/docker/.env:
# mongodb://deepa:deepa_pass@localhost:27017/deepa?authSource=admin
# Production (Atlas), e.g.:
# mongodb+srv://user:password@cluster0.mongodb.net/deepa
MONGODB_URI=

# API rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# JWT secrets (required before auth module is enabled)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Health checks
HEALTH_MEMORY_HEAP_MB=512
HEALTH_DISK_PATH=.

# Swagger UI path (served by the API itself)
SWAGGER_PATH=api/docs