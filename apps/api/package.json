{
  "name": "@deepa/api",
  "version": "0.1.0",
  "description": "Deepa Handmade - NestJS REST API (modular monolith)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @deepa/shared",
    "build": "nest build",
    "prestart:dev": "npm run build --workspace @deepa/shared",
    "pretypecheck": "npm run build --workspace @deepa/shared",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-jest.mjs",
    "test:watch": "node scripts/run-jest.mjs --watch",
    "test:cov": "node scripts/run-jest.mjs --coverage",
    "test:e2e": "node scripts/run-jest.mjs --config ./test/jest-e2e.json",
    "test:ci": "node scripts/run-jest.mjs --ci --coverage --config ./test/jest-ci.json"
  },
  "dependencies": {
    "@deepa/shared": "0.1.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.5.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.2"
  }
}
